<h1>Calculate Monthly Payment</h1>
<form action="/payment/results">
  <div>
    <label for="apr_input">
      APR
    </label>
    <input id="apr_input" type="text" name="user_apr" placeholder="Enter APR (e.g., 5)">
  </div>

  <div>
    <label for="years_input">
      Number of years
    </label>
    <input id="years_input" type="text" name="user_years" placeholder="Enter number of years">
  </div>

  <div>
    <label for="pv_input">
      Principal
    </label>
    <input id="pv_input" type="text" name="user_pv" placeholder="Enter principal amount">
  </div>

  <button>
    Calculate monthly payment
  </button>
</form>
